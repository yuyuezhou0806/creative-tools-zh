diff --git a/crates/ui-egui/tests/fonts.rs b/crates/ui-egui/tests/fonts.rs
index d65b2b6..9f5daed 100644
--- a/crates/ui-egui/tests/fonts.rs
+++ b/crates/ui-egui/tests/fonts.rs
@@ -9,6 +9,23 @@ const CHINESE: &str = "简体中文欢迎";
 const ARABIC: &str = "واحد اثنين";
 const TELUGU: &str = "తెలుగు ఫైల్";
 
+/// The Windows release's Japanese face misses these Simplified Chinese interface
+/// characters. The runtime fallback must cover them in every UI font family.
+#[test]
+#[cfg(windows)]
+fn installed_windows_chinese_font_covers_the_interface() {
+    let defs = theme::installed_font_definitions(true);
+    if !defs.font_data.contains_key(theme::SYSTEM_FALLBACK) {
+        eprintln!("skipping installed_windows_chinese_font_covers_the_interface: no installed Chinese fallback or PDFCRAFT_SYSTEM_FONTS=0");
+        return;
+    }
+    let label = "创建 PDF 编辑 PDF 阅读 转换 电子签名 导出 PDF 组织页面 添加注释 扫描 保护 PDF 压缩 PDF 准备表单 证书 查找工具和命令";
+    let mut fonts = Fonts::new(TextOptions::default(), defs);
+    for id in families() {
+        assert!(fonts.has_glyphs(&id, label), "{id:?} lacks Simplified Chinese interface glyphs");
+    }
+}
+
 fn families() -> Vec<FontId> {
     vec![FontId::proportional(13.0), FontId::monospace(13.0), theme::medium(13.0), theme::semibold(17.0)]
 }
