-/// Magnification as After Effects shows it: "136.1 %", "100 %".
-pub(crate) fn magnification_label(pct: f32) -> String {
-    if (pct - pct.round()).abs() < 0.05 { format!("{:.0} %", pct.round()) } else { format!("{pct:.1} %") }
-}
