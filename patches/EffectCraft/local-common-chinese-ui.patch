+fn kind_name(k: MatteKind) -> &'static str {
+    match k {
+        MatteKind::Alpha => "alpha",
+        MatteKind::AlphaInverted => "alphaInverted",
+        MatteKind::Luma => "luma",
+        MatteKind::LumaInverted => "lumaInverted",
+    }
+}
