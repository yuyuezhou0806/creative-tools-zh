-    pub(crate) fn dock_area(&mut self, ui: &mut egui::Ui, body: Rect) {
-        let t = self.tokens;
-        let ctx = ui.ctx().clone();
-        if self.ui.start_screen {
-            // Home covers the whole workspace, as in After Effects (the panels wait behind it).
