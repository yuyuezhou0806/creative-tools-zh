-fn toggle_popup(ui: &egui::Ui, id: &str) {
-    let pid = egui::Id::new(id).with("open");
-    let open: bool = ui.data(|d| d.get_temp(pid).unwrap_or(false));
-    ui.data_mut(|d| d.insert_temp(pid, !open));
-}
