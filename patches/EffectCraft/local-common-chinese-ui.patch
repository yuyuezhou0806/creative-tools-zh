-/// The resolution popup's label: the chosen factor, or the factor Auto resolves to in brackets.
-pub(crate) fn resolution_label(res: Resolution, scale: f64) -> String {
-    match res {
-        Resolution::Auto => {
-            let r = if scale >= 0.99 {
-                "Full"
-            } else if scale >= 0.49 {
-                "Half"
-            } else if scale >= 0.33 {
-                "Third"
-            } else {
-                "Quarter"
-            };
-            format!("({r})")
-        }
-        Resolution::Custom(n) => format!("Custom ({n})"),
-        r => r.label().to_string(),
-    }
-}
