+/// Placeholder body for panels that are not implemented yet.
+pub fn placeholder(ui: &mut egui::Ui, rect: Rect, t: &Tokens, text: &str) {
+    ui.painter().text(rect.center(), Align2::CENTER_CENTER, text, Tokens::ui(12.0), t.text_faint);
+}
