+fn ws_menu(app: &mut EffectcraftApp, ui: &mut egui::Ui) {
+    for w in app.workspace_names() {
+        if ui.selectable_label(app.ui.workspace == w, if crate::dock::WORKSPACES.contains(&w.as_str()) { crate::i18n::tr(&w) } else { &w }).clicked() {
+            app.set_workspace(&w);
+            ui.close();
+        }
+    }
+    ui.separator();
+    if ui.button(tr("Reset to Saved Layout")).clicked() {
+        let n = app.ui.workspace.clone();
+        app.set_workspace(&n);
+        ui.close();
+    }
+}
