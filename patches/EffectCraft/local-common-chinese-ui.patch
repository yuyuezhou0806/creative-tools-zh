-                return tex;
-            }
-        }
-    }
-    if have == Some(rev) {
-        return tex;
-    }
-    let t = app.session.state.times.get(&it.id).copied().unwrap_or_default();
-    let job = app.session.thumbnail_job(it.id, t, 192)?;
-    let slot: Arc<Mutex<Option<Option<(u32, u32, Vec<u8>)>>>> = Arc::default();
