+    /// A row that translates nothing, repeats a source string, or changes the number of values the
+    /// English source carries is a bug in the catalog itself.
+    #[test]
+    fn catalogs_are_unique_and_keep_the_english_shape() {
+        let hans: Vec<&str> = SIMPLIFIED_CHINESE.iter().map(|(en, _)| *en).collect();
+        let hant: Vec<&str> = TRADITIONAL_CHINESE.iter().map(|(en, _)| *en).collect();
+        assert_eq!(hans, hant, "the two Chinese catalogs list different source strings");
+        let mut sorted = hans.clone();
+        sorted.sort_unstable();
+        let listed = sorted.len();
+        sorted.dedup();
+        assert_eq!(listed, sorted.len(), "a source string is listed twice");
+        for (en, translated) in catalogs() {
+            assert!(!en.is_empty() && !translated.is_empty(), "empty row for {en:?}");
+            assert!(en.contains("{}") || !en.contains('{'), "{en:?} has a placeholder but no `{{}}`");
+            assert_eq!(en.matches("{}").count(), translated.matches("{}").count(), "{en:?} and {translated:?} carry a different number of values");
+        }
+    }
+
+    #[test]
+    fn local_chinese_display_catalog_preserves_values_and_language_fallback() {
+        let mut seen = std::collections::HashSet::new();
+        for (source, translated) in super::super::local_zh::STRINGS {
+            assert!(seen.insert(source), "duplicate local UI source {source:?}");
+            assert!(!translated.is_empty(), "empty local UI translation {source:?}");
+            assert_eq!(source.matches("{}").count(), translated.matches("{}").count(), "value count changed for {source:?}");
+        }
+        set_current("zh-hans");
+        assert_eq!(tr("Project"), "项目");
+        assert_eq!(tr("Light"), "浅色");
+        assert_eq!(tr("Levels of Undo"), "撤销次数");
+        assert_eq!(tr("my layer.mp4"), "my layer.mp4");
+        set_current("en");
+        assert_eq!(tr("Project"), "Project");
+        assert_eq!(tr("Light"), "Light");
+    }
+
+    /// English, a language without rows yet, and anything the catalog does not know stay verbatim:
+    /// a filename or layer name must never be translated.
+    #[test]
+    fn english_and_unknown_text_pass_through() {
+        set_current("en");
+        assert_eq!(tr("Composition Name:"), "Composition Name:");
+        set_current("ja"); // no rows for Japanese yet
+        assert_eq!(tr("Composition Name:"), "Composition Name:");
+        set_current("zh-hans");
+        assert_eq!(tr("Composition Name:"), "合成名称：");
+        assert_eq!(tr("my layer.mp4"), "my layer.mp4");
+        set_current("en");
+    }
+
+    /// Values fill the placeholders in order, and a missing value is dropped instead of panicking.
+    #[test]
+    fn tr_args_fills_values_in_order() {
